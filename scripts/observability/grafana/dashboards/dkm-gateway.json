    {
      "type": "timeseries",
      "title": "Replay lag over time",
      "description": "Lag against the speed that produced it. A flat zero line as speed climbs is the shape to look for; a lag line that starts tracking speed is the ceiling.",
      "datasource": {
        "type": "prometheus",
        "uid": "dkm-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dkm-prometheus"
          },
          "expr": "dkm_playback_lag_milliseconds",
          "legendFormat": "lag",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dkm-prometheus"
          },
          "expr": "dkm_playback_speed",
          "legendFormat": "speed \u00d7",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisBorderShow": false,
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "unit": "ms",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "speed \u00d7"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
