    {
      "type": "row",
      "title": "Visualization path",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Visualization latency",
      "description": "How long the oldest sample in a frame waited between arriving off the wire and being sent to the browser -- the server's half of the wire-to-pixel budget; the other half is one browser animation frame. Empty until a console is open: with nobody watching there is no latency to measure.",
      "datasource": {
        "type": "prometheus",
        "uid": "dkm-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dkm-prometheus"
          },
          "refId": "A",
          "range": true,
          "expr": "dkm_viz_hold_seconds{quantile=\"0.5\"} * 1000",
          "legendFormat": "hold p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dkm-prometheus"
          },
          "refId": "B",
          "range": true,
          "expr": "dkm_viz_hold_seconds{quantile=\"0.95\"} * 1000",
          "legendFormat": "hold p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dkm-prometheus"
          },
          "refId": "C",
          "range": true,
          "expr": "dkm_viz_hold_seconds{quantile=\"0.99\"} * 1000",
          "legendFormat": "hold p99"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dkm-prometheus"
          },
          "refId": "D",
          "range": true,
          "expr": "dkm_viz_build_seconds{quantile=\"0.99\"} * 1000",
          "legendFormat": "frame build p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisBorderShow": false,
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "unit": "ms",
          "min": 0,
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "frame build p99"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    6
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Samples and frames",
      "description": "Dropped and thinned samples affect the picture only. Every message is still sent, still captured and still in the lists -- the visualization path is the one place where falling behind is answered by losing detail rather than by slowing anything down.",
      "datasource": {
        "type": "prometheus",
        "uid": "dkm-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dkm-prometheus"
          },
          "expr": "rate(dkm_viz_samples_total{source=\"dkm\"}[$__rate_interval])",
          "legendFormat": "from DKM",
          "refId": "A",
          "range": true
